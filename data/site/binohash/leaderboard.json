 "metric": {
  "name": "score",
  "formula": "bytes x opcodes x 2^(work_bits - 40)",
  "direction": "lower-is-better",
  "components": [
   {
    "id": "bytes",
    "name": "Script bytes",
    "unit": "bytes",
    "note": "The production locking script plus the largest unlocking script an honest spend can need. Both scripts in full, without their length prefixes; the rest of the two transactions is not counted."
   },
   {
    "id": "opcodes",
    "name": "Opcodes",
    "unit": "counted operations",
    "note": "The interpreter's operation count for the locking script on an honest spend: every opcode above OP_16 plus the number of keys of each executed OP_CHECKMULTISIG. Consensus allows 201."
   },
   {
    "id": "work_bits",
    "name": "Honest grinding work",
    "unit": "log2 SHA-256 compressions",
    "note": "Expected SHA-256 compressions for one honest spend under the reference grinder BH-WORK-1: the pinning puzzles, the rounds' searches and the retries when a round has no solution. The score counts work in units of 2^40 compressions."
   }
  ],
  "fixed": {
   "id": "security_bits",
   "name": "Claimed security level",
   "unit": "bits",
   "note": "Collision resistance under the model BH-SEC-1, in sighash evaluations. Each track fixes a floor; an instance below it is refused."
  }
 },
